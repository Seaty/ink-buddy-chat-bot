# Copy to .env and adjust. Every key is read by core/config.py; missing keys use the defaults there.
# Restart uvicorn after editing — --reload does not watch this file.

# --- App ---
APP_NAME=Ink Buddy Chat Bot
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (docker/compose.yaml; password = POSTGRES_PASSWORD in docker/.env; use 127.0.0.1, not localhost) ---
DATABASE_URL=postgresql+psycopg://ink_buddy:CHANGE_ME@127.0.0.1:5432/ink_buddy

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=300

# --- Vision LLM (qwen3-vl) ---
VISION_MODEL=qwen3-vl:latest
VISION_NUM_PREDICT=6144

# --- Image embedding (Qwen3-VL-Embedding via Hugging Face) ---
IMAGE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# cpu | cuda | gpu | cuda:0 — empty = cuda if available
IMAGE_EMBED_DEVICE=
IMAGE_EMBED_DIM=2048
IMAGE_EMBED_MAX_PIXELS=640000

# --- Retrieval ---
# mock | pgvector
IMAGE_RETRIEVER=mock
CATALOG_DIR=datasets/catalog
IMAGE_TOP_K=5
IMAGE_TAU_EXACT=0.80
IMAGE_TAU_SIMILAR=0.55
IMAGE_W_IMAGE=0.6
IMAGE_W_CAPTION=0.4

# --- Upload limits ---
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=40000000
# private upload storage (relative to backend/)
IMAGE_STORAGE_DIR=uploads
IMAGE_MESSAGE_MAX_CHARS=1000

# --- Fast path ---
# true = find-similar / price questions answered from embeddings only (no VLM, ~1 s)
IMAGE_FAST_PATH=true

# --- Admin ---
# enables POST /api/vision/index (no auth yet — keep false outside local dev)
VISION_ADMIN_ENABLED=false
# TEMPORARY dev-only auth until JWT exists: all requests act as this user. Leave empty outside local dev.
DEV_AUTH_EMAIL=
