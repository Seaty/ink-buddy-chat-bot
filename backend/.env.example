# Copy to .env and adjust. Every key is read by core/config.py; missing keys use the defaults there.
# Restart uvicorn after editing — --reload does not watch this file.

# --- App ---
APP_NAME=Ink Buddy Chat Bot
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (docker/compose.yaml; password = POSTGRES_PASSWORD in docker/.env; use 127.0.0.1, not localhost) ---
DATABASE_URL=postgresql+psycopg://ink_buddy:CHANGE_ME@127.0.0.1:5432/ink_buddy

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=300

# --- Vision LLM (qwen3-vl) ---
VISION_MODEL=qwen3-vl:latest
VISION_NUM_PREDICT=6144
# context window; empty = Ollama default (4096). Larger needs more VRAM.
VISION_NUM_CTX=

# --- Image embedding (Qwen3-VL-Embedding via Hugging Face) ---
IMAGE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# cpu | cuda | gpu | cuda:0 — empty = cuda if available
IMAGE_EMBED_DEVICE=
IMAGE_EMBED_DIM=2048
IMAGE_EMBED_MAX_PIXELS=640000

# --- Retrieval ---
# mock | pgvector
IMAGE_RETRIEVER=mock
CATALOG_DIR=datasets/catalog
IMAGE_TOP_K=5
IMAGE_TAU_SIMILAR=0.55
# no match → offer nearest products as "did you mean?" (min score, how many)
IMAGE_TAU_SUGGEST=0.47
IMAGE_SUGGEST_COUNT=3
IMAGE_W_IMAGE=0.6
IMAGE_W_CAPTION=0.4

# --- Upload limits ---
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=40000000
# private upload storage (relative to backend/)
IMAGE_STORAGE_DIR=uploads
IMAGE_MESSAGE_MAX_CHARS=1000

# --- Fast path ---
# true = find-similar / price questions answered from embeddings only (no VLM, ~1 s)
IMAGE_FAST_PATH=true
# nothing found on the fast path: true = ask the vision model (slow, checks the photo is stationery);
# false = offer the nearest products ("did you mean?") immediately
IMAGE_ESCALATE_ON_NO_MATCH=true

# --- Admin ---
# enables POST /api/v1/admin/image-index; requires admin authentication
VISION_ADMIN_ENABLED=false


# --- Authentication ---
APP_ENVIRONMENT=development
# Required: generate using python -c "import secrets; print(secrets.token_urlsafe(48))"
# No default signing secret. Do not commit your actual value.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=ink-buddy
AUTH_JWT_AUDIENCE=ink-buddy-api
AUTH_ACCESS_SECONDS=900
AUTH_SESSION_SECONDS=604800
AUTH_GUEST_SECONDS=86400
GUEST_RETENTION_SECONDS=86400
AUTH_LIMITER_STORAGE_URI=memory://
# Must match actual uvicorn worker count. Multiple workers require shared storage URI.
AUTH_WORKERS=1

# --- Registration/password reset (Mailpit local; production requires SMTP TLS + HTTPS) ---
AUTH_RESET_SECONDS=900
AUTH_RESET_COOLDOWN_SECONDS=60
AUTH_FRONTEND_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_SENDER=Ink Buddy <noreply@ink-buddy.local>
SMTP_TIMEOUT_SECONDS=10
