{
  "info": {
    "name": "Ink Buddy Hybrid Text Search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Login (User or Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login',()=>pm.response.to.have.status(200)); if(pm.response.code===200)pm.environment.set('access_token',pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:3000"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "2 Hybrid query",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/product-search/by-text",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:3000"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"ปากกาสำหรับจดโน้ต\", \"limit\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Valid retrieval response',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.method).to.eql('hybrid_rrf');pm.expect(r.items.length).to.be.at.most(5);r.items.forEach(h=>{pm.expect(h.product.id).to.be.a('string');pm.expect(h.score).to.be.a('number');});});"
            ]
          }
        }
      ]
    },
