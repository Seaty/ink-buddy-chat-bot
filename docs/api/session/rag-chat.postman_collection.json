    {
      "name": "Conversational price UAT",
      "description": "Run Guest/create chat first. Current reviewed demo catalog expected; index before semantic queries. Paid OpenRouter calls. No secrets exported.",
      "item": [
        {
          "name": "1. Three cheapest blue pens + colors",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat-sessions/{{session_id}}/messages",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"ปากกาหมึกน้ำเงิน สามรุ่นถูกที่สุด และมีสีอื่นไหม\", \"client_request_id\": \"{{client_request_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw=pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g,'');const h=Date.now().toString(16).padStart(12,'0')+'7'+raw.slice(13,16)+raw[16]+raw.slice(17);pm.environment.set('client_request_id',[h.slice(0,8),h.slice(8,12),h.slice(12,16),h.slice(16,20),h.slice(20)].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);const refs=pm.response.json().assistant_message.product_refs||[];",
                  "pm.expect(refs.length).to.be.within(1,3);pm.expect(refs.every(p=>p.price!==null&&p.currency==='THB'&&p.ink_color==='น้ำเงิน')).to.eql(true);const prices=refs.map(p=>Number(p.price));pm.expect(prices).to.eql([...prices].sort((a,b)=>a-b));if(refs.length>=2)pm.environment.set('uat_second_product_id',refs[1].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Follow-up second product price",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat-sessions/{{session_id}}/messages",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"ตัวที่สองราคาเท่าไร\", \"client_request_id\": \"{{client_request_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw=pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g,'');const h=Date.now().toString(16).padStart(12,'0')+'7'+raw.slice(13,16)+raw[16]+raw.slice(17);pm.environment.set('client_request_id',[h.slice(0,8),h.slice(8,12),h.slice(12,16),h.slice(16,20),h.slice(20)].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);const refs=pm.response.json().assistant_message.product_refs||[];",
                  "pm.expect(refs.length).to.eql(1);pm.expect(refs[0].id).to.eql(pm.environment.get('uat_second_product_id'));pm.expect(refs[0].price).not.to.eql(null);"
                ]
              }
            }
          ]
