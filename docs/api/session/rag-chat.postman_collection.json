  "item": [
    {
      "name": "Guest flow",
      "item": [
        {
          "name": "Create Guest",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/guest-sessions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.expect([200,201]).to.include(pm.response.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create chat",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat-sessions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);pm.environment.set('session_id',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send RAG message",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat-sessions/{{session_id}}/messages",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"ปากกาเจล ไม่เกิน 100 บาท\", \"client_request_id\": \"{{client_request_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw=pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g,'');const h=Date.now().toString(16).padStart(12,'0')+'7'+raw.slice(13,16)+raw[16]+raw.slice(17);pm.environment.set('client_request_id',[h.slice(0,8),h.slice(8,12),h.slice(12,16),h.slice(16,20),h.slice(20)].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);const r=pm.response.json();pm.expect(r.assistant_message.model_name).to.eql('qwen/qwen3-14b');pm.environment.set('assistant_message_id',r.assistant_message.id);"
                ]
