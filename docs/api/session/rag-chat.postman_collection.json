            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);const refs=pm.response.json().assistant_message.product_refs||[];",
                  "pm.expect(refs.every(p=>p.price!==null&&Number(p.price)<=50)).to.eql(true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
